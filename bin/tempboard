#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""tempboard is now Cera — this old command name only forwards to bin/cera (same arguments, same exit code)."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
lang = (os.environ.get("CERA_LANG") or os.environ.get("TEMPBOARD_LANG") or os.environ.get("LC_ALL") or os.environ.get("LANG") or "").lower()
sys.stderr.write("tempboard 는 이제 cera 다 — 앞으로는 `cera` 명령을 쓰세요\n" if lang.startswith("ko")
                 else "tempboard is now cera - please use the `cera` command from now on\n")
sys.stderr.flush()
cli = os.path.join(here, "cera")
os.execv(sys.executable, [sys.executable, cli] + sys.argv[1:])
