#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Cera — a temporary whiteboard site you draw on together just by sending a link.
Named after the Roman wax tablet (cera): write, smooth it over, write again.

    cera start [--title meeting] [--ttl 12h] [--view-link] [--tunnel cloudflared|none] [--lan]
    cera list                 # current and past sites
    cera links <id>           # show the invite links again
    cera keys <id> --rotate edit|view|all   # change invite keys (old links and open screens are cut off within 2 seconds)
    cera stop <id> | --all    # close (drawings are kept)
    cera export <id> [--out DIR]   # one .excalidraw file per board
    cera delete <id>          # delete, drawings included
    cera import <id> <file>   # import .excalidraw, .excalidrawlib, or images
    cera agent add|list|revoke <id>   # agent tokens
    cera mcp                  # stdio MCP server (launched by the agent)
    cera site guide|init|run|install|status|doctor   # personal board web (your own domain)
    cera lang [ko|en|auto]    # language of messages (Korean / English)
    cera install|uninstall --agent claude|codex|antigravity|all [--mode plugin|link]

One site = one server + (optionally) a Cloudflare temporary tunnel + invite keys + an expiry time. Data lives in $CERA_HOME (default ~/.cera;
an old ~/.tempboard is moved there on the first run and left as a link). Every CERA_* variable also works under its old TEMPBOARD_* name.
Web files (dist): $CERA_DIST > web/dist in the checkout (if built) > $CERA_HOME/dist/<version>/ (downloaded or built result).
"""
from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
REPO = "Joonoh991119/cera"
TUNNEL_RE = re.compile(r"https://[a-z0-9-]+\.trycloudflare\.com")
# Extension slots — if server/<name>.py exists, load it and call register(sub, ctx) (silently skipped if absent).
# agents (tokens) · tb_mcp (MCP) · importers · personal (site) · install_agents
EXT_MODULES = ("agents", "tb_mcp", "importers", "personal", "install_agents")


def version():
    try:
        return json.loads((ROOT / ".claude-plugin" / "plugin.json").read_text())["version"]
    except (OSError, KeyError, ValueError):
        return "0.0.0"


def resolve_dist():
    """Location of the web files. The plugin root may be read-only or change per release (Claude, Codex, Antigravity installs), so downloaded or built
    results go in $CERA_HOME/dist/<version>/. If web/dist is built in a development checkout, that is used as is."""
    v = env("DIST")
    if v:
        return Path(v).expanduser()
    dev = ROOT / "web" / "dist"
    if (dev / "index.html").is_file():
        return dev
    return HOME / "dist" / re.sub(r"[^0-9A-Za-z.+-]", "_", version())


def load_module(name, path=None):
    """Load server/<name>.py once as `cera_<name>` (loading it several times yields the same module and the same classes)."""
    key = "cera_" + name
    if key not in sys.modules:
        spec = importlib.util.spec_from_file_location(key, path or ROOT / "server" / f"{name}.py")
        mod = importlib.util.module_from_spec(spec)
        sys.modules[key] = mod
        try:
            spec.loader.exec_module(mod)
        except BaseException:
            sys.modules.pop(key, None)
            raise
    return sys.modules[key]


def T(ko, en):
    """Korean or English text — see server/i18n.py (CERA_LANG > `cera lang` > locale > English)."""
    return load_module("i18n").T(ko, en)


def env(name, default=None):
    """CERA_<name>, else the old TEMPBOARD_<name> (server/env.py)."""
    return load_module("env").env(name, default)


def resolve_home():
    """The data folder. On the first run without CERA_HOME / TEMPBOARD_HOME, an old ~/.tempboard is moved to ~/.cera
    (a link ~/.tempboard -> ~/.cera is left for services installed earlier). Nothing is ever deleted."""
    e = load_module("env")
    res = e.migrate_home()
    if res.startswith("migrated"):
        print(T(f"데이터 폴더를 옮겼다: ~/{e.OLD_DIR} → ~/{e.DIR} (~/{e.OLD_DIR} 는 링크로 남겼다)",
                f"Moved the data folder: ~/{e.OLD_DIR} -> ~/{e.DIR} (~/{e.OLD_DIR} is left as a link)"), file=sys.stderr)
    elif res.startswith("failed"):
        print(T(f"주의: ~/{e.OLD_DIR} 를 ~/{e.DIR} 로 옮기지 못해 그대로 쓴다 — {res[8:]}",
                f"Warning: could not move ~/{e.OLD_DIR} to ~/{e.DIR}, so it stays in use - {res[8:]}"), file=sys.stderr)
    return e.home()


HOME = resolve_home()
SITES = HOME / "sites"
DIST = resolve_dist()


def load_server():
    return load_module("server")


def supervise():
    return load_module("supervise")


# ------------------------------------------------------------------ state file
def state_path(sid):
    return SITES / sid / "state.json"


def read_state(sid):
    return supervise().read_state(SITES, sid)


def update_state(sid, fn):
    """Lock state.json (state.lock), read, fn(st), write atomically (0600). The supervisor, keys, agent, and MCP all write through this."""
    return supervise().update_state(SITES, sid, fn)


def write_state(sid, st):
    """Write the whole file (only when creating a new site). Use update_state for modifications."""
    return update_state(sid, lambda _cur: dict(st))


def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False


def live_status(st):
    if st.get("status") in ("running", "starting") and not alive(st.get("pid")):
        return "stopped"
    return st.get("status", "?")


def parse_ttl(s):
    s = str(s).strip().lower()
    if s in ("0", "none", "forever", "무기한"):
        return 0
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([smhd]?)", s)
    if not m:
        raise SystemExit(T(f"--ttl 을 읽지 못했다: {s} (예: 30m · 3h · 2d · 0=닫을 때까지)", f"Cannot read --ttl: {s} (e.g. 30m · 3h · 2d · 0 = until closed)"))
    return int(float(m.group(1)) * {"": 3600, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)])


def access_mode(st):
    """A personal site with Cloudflare Access on — the public address needs no key (Access login); the invite key works only on this computer's address."""
    return st.get("mode") == "personal" and bool(st.get("access"))


def links(st):
    out = {}
    if access_mode(st) and st.get("public_url"):
        board = f"#b={st['board']}" if st.get("board") else ""
        out["edit"] = f"{st['public_url']}/{board}"
        if st.get("local_url"):
            out["local"] = f"{st['local_url']}/?k={st['edit_key']}{board}"
        return out
    base = st.get("public_url") or st.get("local_url")
    board = f"#b={st['board']}" if st.get("board") else ""
    if base:
        out["edit"] = f"{base}/?k={st['edit_key']}{board}"
        if st.get("view_key"):
            out["view"] = f"{base}/?k={st['view_key']}{board}"
    if st.get("local_url") and st.get("public_url"):
        out["local"] = f"{st['local_url']}/?k={st['edit_key']}{board}"
    return out


def lan_ip():
    return load_module("security").lan_ip()


# ------------------------------------------------------------------ web files (dist)
def _install_dist(src: Path):
    """Make the fully downloaded (built) folder the DIST — rename it into place if DIST is absent (atomic), fill it if it exists as an empty folder."""
    DIST.parent.mkdir(parents=True, exist_ok=True)
    if DIST.is_dir() and not any(DIST.iterdir()):
        try:
            DIST.rmdir()
        except OSError:
            pass
    if not DIST.exists():
        try:
            os.replace(src, DIST)
            return
        except OSError:
            if (DIST / "index.html").is_file():   # another run that downloaded concurrently placed it first
                return
    shutil.copytree(src, DIST, dirs_exist_ok=True)


def release_url():
    base = env("RELEASE_URL") or f"https://github.com/{REPO}/releases/download/v{version()}"
    return base.rstrip("/") + "/cera-dist.tar.gz"


def ensure_dist():
    if (DIST / "index.html").is_file():
        return
    url = release_url()
    print(T(f"화면 파일이 없어 받는다: {url} → {DIST}", f"Web files are missing; downloading: {url} -> {DIST}"), file=sys.stderr)
    hint = T("Node.js(npm) 를 설치하거나 네트워크를 확인하세요", "Install Node.js (npm) or check your network")
    try:
        DIST.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(dir=DIST.parent, prefix=".dist-") as td:   # same disk — only a rename at the end
            tgz = Path(td) / "dist.tar.gz"
            with urllib.request.urlopen(url, timeout=60) as r, open(tgz, "wb") as fh:
                shutil.copyfileobj(r, fh)
            out = Path(td) / "x"
            with tarfile.open(tgz) as t:
                for m in t.getmembers():   # prevent path escape
                    if m.name.startswith("/") or ".." in Path(m.name).parts or not (m.isfile() or m.isdir()):
                        raise SystemExit(T(f"이상한 항목: {m.name}", f"Unexpected entry in archive: {m.name}"))
                t.extractall(out)
            src = out / "dist" if (out / "dist").is_dir() else out
            if not (src / "index.html").is_file():
                raise ValueError(T("묶음에 index.html 이 없다", "index.html is missing from the archive"))
            _install_dist(src)
            return
    except Exception as e:   # noqa: BLE001 — if the download fails, build directly
        if getattr(e, "code", None) == 404:   # the network works but this version's Release asset does not exist (yet)
            hint = T(f"v{version()} Release 자산(cera-dist.tar.gz)이 아직 없다 — Node.js(npm) 로 빌드하거나, "
                     "빌드한 dist 를 CERA_DIST 로 가리키세요",
                     f"The v{version()} Release asset (cera-dist.tar.gz) does not exist yet - build with Node.js (npm), "
                     "or point CERA_DIST at a dist you built")
        print(T(f"받기 실패({e}) — npm 으로 직접 빌드한다", f"Download failed ({e}) - building with npm instead"), file=sys.stderr)
    if not shutil.which("npm"):
        raise SystemExit(T("화면 파일을 받지도 빌드하지도 못했다 — ", "Could neither download nor build the web files - ") + hint)
    web = ROOT / "web"
    if not os.access(web, os.W_OK):
        raise SystemExit(T(f"화면 파일을 받지 못했고 {web} 에 쓸 수 없어 빌드도 못 한다(플러그인 설치본은 읽기 전용일 수 있다) — "
                           "네트워크를 확인하거나, 저장소를 받아 빌드한 dist 를 CERA_DIST 로 가리키세요",
                           f"Could not download the web files, and {web} is not writable so they cannot be built (a plugin install may be read-only) - "
                           "check your network, or clone the repository, build it, and point CERA_DIST at the dist"))
    # npm output goes to stderr — the stdout of `start --json` must be a single JSON blob only (MCP reads it)
    subprocess.run(["npm", "ci", "--no-audit", "--no-fund"], cwd=web, check=True, stdout=sys.stderr)
    subprocess.run(["npm", "run", "build"], cwd=web, check=True, stdout=sys.stderr)
    if DIST.resolve() != (web / "dist").resolve() and not (DIST / "index.html").is_file():
        with tempfile.TemporaryDirectory(dir=DIST.parent, prefix=".dist-") as td:
            tmp = Path(td) / "dist"
            shutil.copytree(web / "dist", tmp)
            _install_dist(tmp)


# ------------------------------------------------------------------ start
def cmd_start(a):
    ttl = parse_ttl(a.ttl)
    if a.tunnel == "cloudflared" and not shutil.which("cloudflared"):
        raise SystemExit(T("cloudflared 가 없다 — `brew install cloudflared`(macOS) 또는 https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/ . "
                           "같은 네트워크 안에서만 쓰려면 --tunnel none --lan",
                           "cloudflared is not installed - `brew install cloudflared` (macOS) or https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/ . "
                           "To use it only inside the same network: --tunnel none --lan"))
    ensure_dist()
    sid = time.strftime("%m%d-%H%M") + "-" + secrets.token_hex(2)
    d = SITES / sid
    (d / "data").mkdir(parents=True)
    os.chmod(d, 0o700)
    srv = load_server()
    board = None
    if a.title is not None:
        store = srv.Store(d / "data")
        board = store.create(a.title.strip() or T("새 보드", "New board"), {"name": a.name or "host"}).id
    st = {"id": sid, "title": a.title or "", "board": board, "status": "starting", "created_at": time.time(),
          "expires_at": time.time() + ttl if ttl else 0, "edit_key": secrets.token_urlsafe(18),
          "view_key": secrets.token_urlsafe(18) if a.view_link else None, "tunnel": a.tunnel,
          "host": "0.0.0.0" if a.lan else "127.0.0.1", "port": a.port, "pid": None, "public_url": None, "local_url": None}
    write_state(sid, st)
    log = open(d / "log.txt", "ab")
    os.chmod(d / "log.txt", 0o600)
    p = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "_serve", sid], stdin=subprocess.DEVNULL,
                         stdout=log, stderr=log, start_new_session=True)
    deadline = time.time() + 45
    while time.time() < deadline:
        time.sleep(0.3)
        st = read_state(sid) or st
        if st["status"] == "running" and (a.tunnel == "none" or st.get("public_url")):
            break
        if p.poll() is not None or st["status"] == "failed":
            raise SystemExit(T(f"시작 실패 — {d / 'log.txt'}\n", f"Failed to start - {d / 'log.txt'}\n") + (d / "log.txt").read_text(errors="replace")[-1500:])
    else:
        print(T("주의: 45초 안에 터널 주소가 나오지 않았다 — 조금 뒤 `cera links " + sid + "`",
                "Warning: no tunnel address appeared within 45 seconds - try `cera links " + sid + "` in a moment"), file=sys.stderr)
    show(st, a.json)


def show(st, as_json=False, extra=None):
    if access_mode(st) and st.get("public_url"):
        return show_access(st, as_json, extra)
    ln = links(st)
    if as_json:
        print(json.dumps({"id": st["id"], "status": live_status(st), "expires_at": st.get("expires_at") or None, "links": ln,
                          "data": str(SITES / st["id"] / "data"), **(extra or {})}, ensure_ascii=False))
        return
    exp = (time.strftime("%m/%d %H:%M", time.localtime(st["expires_at"])) + T(" 에 닫힘", " closes")) if st.get("expires_at") else T("닫을 때까지 열림", "open until closed")
    print(f"Cera {st['id']} — {live_status(st)} · {exp}")
    if "edit" in ln:
        print(T("  같이 그리기  ", "  Draw together  ") + ln['edit'])
    if "view" in ln:
        print(T("  보기 전용    ", "  View only      ") + ln['view'])
    if "local" in ln:
        print(T("  (이 컴퓨터)  ", "  (this computer) ") + ln['local'])
    if st.get("tunnel") == "none" and st.get("host") == "127.0.0.1":
        print(T("  ※ 이 컴퓨터에서만 열린다(--tunnel none). 같은 와이파이 사람과 쓰려면 --lan, 어디서나 쓰려면 cloudflared",
                "  Note: opens on this computer only (--tunnel none). Use --lan for people on the same Wi-Fi, or cloudflared for anywhere"))


def show_access(st, as_json=False, extra=None):
    ln = links(st)
    note = T("공개 주소는 Cloudflare Access 로그인 뒤 열린다(초대 키 없음). 들어올 사람은 Access 정책과 members.json 으로 정한다.",
             "The public address opens after a Cloudflare Access login (no invite key). Who may enter is decided by the Access policy and members.json.")
    if as_json:
        print(json.dumps({"id": st["id"], "status": live_status(st), "expires_at": None, "links": ln,
                          "access": {"team": st["access"].get("team")}, "note": note, "data": str(SITES / st["id"] / "data"),
                          **(extra or {})}, ensure_ascii=False))
        return
    print(T(f"Cera {st['id']} — {live_status(st)} · 닫을 때까지 열림 · Cloudflare Access({st['access'].get('team')})",
            f"Cera {st['id']} - {live_status(st)} · open until closed · Cloudflare Access({st['access'].get('team')})"))
    print(T(f"  공개 주소    {ln['edit']}   ← Access 로그인(이메일 1회용 번호)", f"  Public address  {ln['edit']}   <- Access login (one-time email code)"))
    if "local" in ln:
        print(T("  (이 컴퓨터)  ", "  (this computer) ") + ln['local'])
    print("  ※ " + note)


# ------------------------------------------------------------------ _serve (background supervisor process)
def quick_tunnel_cmd(port):
    return ["cloudflared", "tunnel", "--no-autoupdate", "--url", f"http://127.0.0.1:{port}"]


def quick_tunnel_url(line):
    m = TUNNEL_RE.search(line)
    return m.group(0) if m else None


def cmd_serve(a):
    """Server + quick tunnel (reopened up to 5 times) + expiry + re-reading state.json (key rotation). The loop is in server/supervise.py."""
    st = read_state(a.id)
    quick = st.get("tunnel") == "cloudflared"
    supervise().run(a.id, st, quick_tunnel_cmd if quick else None, quick_tunnel_url if quick else None, retries=5,
                    sites=SITES, dist=DIST, server=load_server())


# ------------------------------------------------------------------ the rest
def all_sites():
    if not SITES.is_dir():
        return []
    out = [read_state(p.name) for p in SITES.iterdir() if (p / "state.json").is_file()]
    return sorted([s for s in out if s], key=lambda s: s.get("created_at", 0), reverse=True)


def need(sid):
    st = read_state(sid)
    if not st:
        ids = [s["id"] for s in all_sites()]
        raise SystemExit(T(f"사이트 {sid} 가 없다. 있는 것: {', '.join(ids) or '없음'}", f"No site {sid}. Existing: {', '.join(ids) or 'none'}"))
    return st


def cmd_list(a):
    sites = all_sites()
    if a.json:
        print(json.dumps([{"id": s["id"], "title": s.get("title"), "status": live_status(s), "expires_at": s.get("expires_at") or None,
                           "links": links(s) if live_status(s) == "running" else {}} for s in sites], ensure_ascii=False))
        return
    if not sites:
        print(T("사이트가 없다 — cera start", "No sites - cera start"))
        return
    for s in sites:
        stt = live_status(s)
        n = len(list((SITES / s["id"] / "data" / "boards").glob("*/board.json")))
        extra = ""
        if stt == "running":
            extra = " · " + (time.strftime("%m/%d %H:%M", time.localtime(s["expires_at"])) + T(" 닫힘", " closes") if s.get("expires_at") else T("닫을 때까지", "until closed"))
        print(T(f"{s['id']}  {stt:8}  보드 {n}  {s.get('title') or ''}{extra}", f"{s['id']}  {stt:8}  boards {n}  {s.get('title') or ''}{extra}"))


def cmd_links(a):
    st = need(a.id)
    if live_status(st) != "running":
        print(T(f"{a.id} 는 닫혀 있다({live_status(st)}). 다시 열려면 새로 start 하고, 그림은 export 로 꺼낸다.",
                f"{a.id} is closed ({live_status(st)}). To open again, run start anew; take the drawings out with export."))
        return
    show(st, a.json)


def cmd_stop(a):
    targets = [s for s in all_sites() if live_status(s) == "running"] if a.all else [need(a.id)]
    for st in targets:
        pid = st.get("pid")
        # First record that "a human asked to stop it" — so the always-on service does not wait and take over (personal.cmd_run)
        update_state(st["id"], lambda cur: cur.update(stop_requested_at=time.time()))
        if alive(pid):
            os.kill(pid, signal.SIGTERM)
            for _ in range(50):
                if not alive(pid):
                    break
                cur = read_state(st["id"]) or {}
                # The supervisor writes stopped and pid None just before ending. A child the parent has not yet reaped (a zombie) still succeeds with kill(0), so
                # check the state too (otherwise it would wait the full 5 seconds)
                if cur.get("status") not in ("running", "starting") and cur.get("pid") in (None, 0):
                    break
                time.sleep(0.1)
        def mark(cur):
            if cur.get("status") in ("running", "starting"):   # when the supervisor died without cleaning up after itself
                cur.update(status="stopped", pid=None)
                if cur.get("tunnel") == "cloudflared":   # clear only the quick tunnel address (a named tunnel address is configuration)
                    cur["public_url"] = None
        update_state(st["id"], mark)
        print(T(f"{st['id']} 닫음 — 그림은 {SITES / st['id'] / 'data'} 에 남아 있다", f"{st['id']} closed - drawings remain in {SITES / st['id'] / 'data'}"))


def cmd_keys(a):
    """Change the invite keys — once a new key is written to state.json, the supervise loop re-reads it within 1 second. Old links and cookies are blocked and open screens are cut off."""
    st = need(a.id)
    if not a.rotate:
        show(st, a.json)
        if access_mode(st) and not a.json:
            print(T(f"  ※ Access 모드: 공개 주소 https://{st.get('hostname')}/ 는 키 없이 Access 로그인으로 연다 — 초대 키는 이 컴퓨터(127.0.0.1)에서만 쓰인다",
                  f"  Note: Access mode - the public address https://{st.get('hostname')}/ opens with an Access login, no key; invite keys work only on this computer (127.0.0.1)"))
        return
    if a.rotate == "view" and not st.get("view_key"):
        raise SystemExit(T(f"{a.id} 에는 보기 링크가 없다 — --rotate edit 또는 all", f"{a.id} has no view link - use --rotate edit or all"))

    def rotate(cur):
        if a.rotate in ("edit", "all"):
            cur["edit_key"] = secrets.token_urlsafe(18)
        if a.rotate in ("view", "all") and cur.get("view_key"):
            cur["view_key"] = secrets.token_urlsafe(18)
        cur["keys_rotated_at"] = time.time()
    st = update_state(a.id, rotate)
    if not a.json:
        what = {"edit": T("편집 키", "edit key"), "view": T("보기 키", "view key"), "all": T("모든 키", "all keys")}[a.rotate]
        tail = (T("옛 링크와 열린 화면은 2초 안에 끊긴다. 아래 새 링크를 다시 보내세요.", "Old links and open screens are cut off within 2 seconds. Send the new links below again.")
                if live_status(st) == "running" else T("사이트는 닫혀 있다.", "The site is closed."))
        print(T(f"{what}를 바꿨다 — {tail}", f"Rotated {what} - {tail}"))
    n = sum(1 for t in (st.get("agents") or []) if isinstance(t, dict) and not (t.get("expires_at") and float(t["expires_at"]) <= time.time()))
    # Agent tokens are separate from invite keys — also put them in the JSON so automation (MCP) can know them
    show(st, a.json, {"agent_tokens_kept": n, "revoke_agents": f"cera agent revoke {a.id} --all"})
    if not a.json:
        have = T(f"(지금 {n}개)", f" ({n} now)") if n else ""
        print(T(f"  ※ 에이전트 토큰{have}은 그대로다 — 초대 키와 따로다. 에이전트도 끊으려면  cera agent revoke {a.id} --all",
                f"  Note: agent tokens{have} are unchanged - they are separate from invite keys. To cut agents off too:  cera agent revoke {a.id} --all"))
    if access_mode(st) and not a.json:
        print(T(f"  ※ Access 모드: 공개 주소 https://{st.get('hostname')}/ 는 키 없이 Access 로그인으로 연다 — 초대 키는 이 컴퓨터(127.0.0.1)에서만 쓰인다",
                  f"  Note: Access mode - the public address https://{st.get('hostname')}/ opens with an Access login, no key; invite keys work only on this computer (127.0.0.1)"))


def cmd_lang(a):
    """cera lang [ko|en|auto] — show where the current language comes from, or save / clear the choice."""
    i18n = load_module("i18n")
    if a.value:
        i18n.save(None if a.value == "auto" else a.value)
        if a.value == "auto":
            print(T("저장한 언어를 지웠다 — 이제 환경 변수 · 시스템 로케일을 따른다", "Cleared the saved language - now following the environment and system locale"))
        else:
            print(T(f"언어를 {a.value} 로 저장했다 ({i18n.config_path()})", f"Language saved as {a.value} ({i18n.config_path()})"))
        if (env("LANG") or "").strip().lower() in i18n.LANGS:
            print(T("  ※ 환경 변수 CERA_LANG 이 설정돼 있어 그쪽이 먼저 적용된다", "  Note: the CERA_LANG environment variable is set and takes precedence"))
        return
    v = (env("LANG") or "").strip().lower()
    if v in i18n.LANGS:
        cur, src = v, "env"
    elif i18n.saved():
        cur, src = i18n.saved(), "saved"
    elif any((os.environ.get(k) or "").strip().lower() not in ("", "c", "posix") and not (os.environ.get(k) or "").lower().startswith("c.")
             for k in ("LC_ALL", "LC_MESSAGES", "LANG")):
        cur, src = i18n.from_locale(), "locale"   # a real locale was found (Korean or not)
    else:
        cur, src = "en", "default"
    why = {"env": T("환경 변수 CERA_LANG", "environment variable CERA_LANG"),
           "saved": T(f"저장한 설정 ({i18n.config_path()})", f"saved setting ({i18n.config_path()})"),
           "locale": T("시스템 로케일", "system locale"), "default": T("기본값(영어)", "default (English)")}[src]
    print(T(f"언어: {cur}  (출처: {src} — {why})", f"Language: {cur}  (source: {src} - {why})"))


def cmd_export(a):
    st = need(a.id)
    out = Path(a.out or Path.cwd() / f"cera-{st['id']}")
    out.mkdir(parents=True, exist_ok=True)
    n = 0
    for bj in sorted((SITES / st["id"] / "data" / "boards").glob("*/board.json")):
        d = json.loads(bj.read_text(encoding="utf-8"))
        els = [e for e in d.get("elements", []) if not e.get("isDeleted")]
        files = {}
        for e in els:
            fid = e.get("fileId")
            fp = bj.parent / "files" / str(fid)
            if fid and fp.is_file():
                files[fid] = json.loads(fp.read_text())
        title = (d.get("meta") or {}).get("title") or bj.parent.name
        name = re.sub(r"[^\w가-힣.-]+", "_", title).strip("_")[:60] or bj.parent.name
        doc = {"type": "excalidraw", "version": 2, "source": "cera", "elements": els,
               "appState": {"viewBackgroundColor": "#ffffff"}, "files": files}
        (out / f"{name}-{bj.parent.name}.excalidraw").write_text(json.dumps(doc, ensure_ascii=False), encoding="utf-8")
        n += 1
    print(T(f"보드 {n}개 → {out}  (excalidraw.com 에서 열거나 다시 붙여 넣을 수 있다)", f"{n} boards -> {out}  (open at excalidraw.com or paste back in)"))


def cmd_delete(a):
    st = need(a.id)
    if live_status(st) == "running":
        raise SystemExit(T("열려 있는 사이트다 — 먼저 cera stop ", "The site is open - run first: cera stop ") + a.id)
    personal = st.get("mode") == "personal"
    if personal:
        svc = service_file(st)
        if svc:
            raise SystemExit(T(f"늘 켜 두기 서비스가 설치돼 있다({svc}) — 지우면 서비스가 10초마다 다시 떠 실패한다.\n"
                               f"먼저:  cera site uninstall --id {a.id} --load",
                               f"The always-on service is installed ({svc}) - deleting would make it restart and fail every 10 seconds.\n"
                               f"First:  cera site uninstall --id {a.id} --load"))
    if not a.yes:
        raise SystemExit(T(f"그림까지 지운다: {SITES / a.id}  — 정말이면 --yes", f"This deletes the drawings too: {SITES / a.id}  - add --yes to confirm"))
    # board_snapshot images of this site (tb_mcp.py: <site>-<board>-<n>.png) go first: if one cannot be removed, stop while the site still
    # exists, so the same command can be run again after fixing the permission
    # (listed with os.listdir, not glob: glob silently returns nothing for a folder it cannot read)
    sdir, failed = HOME / "snapshots", []
    try:
        names = os.listdir(sdir)
    except FileNotFoundError:
        names = []
    except OSError as e:
        names, failed = [], [f"{sdir}: {e.strerror or e}"]
    snaps = [sdir / n for n in names if re.fullmatch(re.escape(a.id) + r"-[A-Za-z0-9_]{1,64}-\d+\.png", n)]
    for snap in snaps:
        try:
            snap.unlink()
        except FileNotFoundError:
            pass
        except OSError as e:
            failed.append(f"{snap}: {e.strerror or e}")
    if failed:
        raise SystemExit(T(f"스냅샷 그림 {len(failed)}개를 지우지 못해 사이트는 그대로 두었다:\n  ", f"Could not delete {len(failed)} snapshot image(s), so the site was left as is:\n  ")
                         + "\n  ".join(failed[:10]))
    kept = keep_tunnel_files(a.id) if personal else None
    shutil.rmtree(SITES / a.id)
    print(T(f"{a.id} 지움", f"{a.id} deleted"))
    if kept:
        print(T(f"터널 자격 · 설정은 지우지 않고 옮겼다: {kept}  (0700)\n"
                f"  Cloudflare 쪽 터널 · DNS 레코드는 그대로다. 다시 쓰려면 site init --reuse-tunnel, 없애려면 사람이\n"
                f"  cloudflared tunnel delete {st.get('tunnel_name') or '<터널 이름>'} 과 대시보드의 DNS 레코드 삭제.",
                f"Tunnel credentials and config were moved, not deleted: {kept}  (0700)\n"
                f"  The Cloudflare-side tunnel and DNS record are untouched. To reuse: site init --reuse-tunnel; to remove, a person runs\n"
                f"  cloudflared tunnel delete {st.get('tunnel_name') or '<tunnel name>'} and deletes the DNS record in the dashboard."))


def service_file(st):
    """Path of this personal site's always-on file (LaunchAgent plist, systemd unit), if it exists."""
    cands = []
    svc = st.get("service") or {}
    if svc.get("path"):
        cands.append(Path(svc["path"]))
    try:
        pm = load_module("personal")
        plat = pm.platform_name()
        if plat:
            cands.append(pm.service_path(st["id"], plat))
            cands.append(pm.service_path(st["id"], plat, legacy=True))   # installed before the rename (tempboard)
    except Exception:   # noqa: BLE001 — if the personal extension is absent, look only at the path in state
        pass
    return next((p for p in cands if p.exists()), None)


def keep_tunnel_files(sid):
    """When deleting a personal site, move the tunnel credentials (tunnel.json) and config to $CERA_HOME/kept/<id>-<time>/.
    If the credentials are lost, a tunnel with the same name cannot be reused (the Cloudflare-side tunnel and DNS remain)."""
    d = SITES / sid
    names = [n for n in ("tunnel.json", "cloudflared.yml", "members.json") if (d / n).is_file()]
    names += [p.name for p in d.glob("tunnel.json.bak-*") if p.is_file()]
    if not names:
        return None
    dst = HOME / "kept" / f"{sid}-{time.strftime('%Y%m%d-%H%M%S')}"
    dst.mkdir(parents=True, exist_ok=False)
    os.chmod(dst.parent, 0o700)
    os.chmod(dst, 0o700)
    for n in names:
        shutil.move(str(d / n), str(dst / n))
    return dst


def ext_context():
    """What an extension's register(sub, ctx) receives — paths, state file, server module, links, web files."""
    import types
    return types.SimpleNamespace(
        ROOT=ROOT, HOME=HOME, SITES=SITES, DIST=DIST, version=version, read_state=read_state, update_state=update_state,
        load_server=load_server, load_module=load_module, supervise=supervise, links=links, alive=alive, ensure_dist=ensure_dist,
        need=need, show=show, live_status=live_status, all_sites=all_sites, lan_ip=lan_ip)


def load_extensions(sub):
    ctx = None
    for name in EXT_MODULES:
        path = ROOT / "server" / f"{name}.py"
        if not path.is_file():
            continue
        try:
            mod = load_module(name, path)
            if hasattr(mod, "register"):
                ctx = ctx or ext_context()
                mod.register(sub, ctx)
        except Exception as e:   # noqa: BLE001 — even if one extension is broken, basic commands like start and stop still work
            print(T(f"주의: 확장 {name} 을 불러오지 못했다 — {type(e).__name__}: {e}", f"Warning: could not load extension {name} - {type(e).__name__}: {e}"), file=sys.stderr)


def main():
    ap = argparse.ArgumentParser(prog="cera", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("start", help=T("새 임시 사이트 열기", "Open a new temporary site"))
    s.add_argument("--title", default=None, help=T("첫 보드 이름 — 주면 링크가 그 보드로 바로 연다", "Name of the first board - if given, the link opens that board directly"))
    s.add_argument("--ttl", default="12h", help=T("열어 둘 시간(30m · 3h · 2d · 0=닫을 때까지). 기본 12h", "How long to keep it open (30m · 3h · 2d · 0 = until closed). Default 12h"))
    s.add_argument("--view-link", action="store_true", help=T("보기 전용 링크도 만든다", "Also create a view-only link"))
    s.add_argument("--tunnel", choices=["cloudflared", "none"], default="cloudflared", help=T("공개 주소(기본 Cloudflare 임시 터널, 계정 불필요)", "Public address (default: Cloudflare temporary tunnel, no account needed)"))
    s.add_argument("--lan", action="store_true", help=T("같은 네트워크(와이파이)에서 들어올 수 있게 0.0.0.0 에 연다", "Listen on 0.0.0.0 so people on the same network (Wi-Fi) can join"))
    s.add_argument("--port", type=int, default=0)
    s.add_argument("--name", default=None, help=T("첫 보드를 만든 사람 이름", "Name of the person who creates the first board"))
    s.add_argument("--json", action="store_true")
    s.set_defaults(f=cmd_start)
    s = sub.add_parser("list", help=T("사이트 목록", "List sites"))
    s.add_argument("--json", action="store_true")
    s.set_defaults(f=cmd_list)
    s = sub.add_parser("links", help=T("초대 링크 다시 보기", "Show the invite links again"))
    s.add_argument("id")
    s.add_argument("--json", action="store_true")
    s.set_defaults(f=cmd_links)
    s = sub.add_parser("stop", help=T("닫기(그림은 남는다)", "Close (drawings are kept)"))
    s.add_argument("id", nargs="?")
    s.add_argument("--all", action="store_true")
    s.set_defaults(f=cmd_stop)
    s = sub.add_parser("keys", help=T("초대 키 보기 · 바꾸기(--rotate)", "Show or change invite keys (--rotate)"))
    s.add_argument("id")
    s.add_argument("--rotate", choices=["edit", "view", "all"], default=None, help=T("바꿀 키. 없으면 지금 링크만 보여 준다", "Key to change. Without it, only the current links are shown"))
    s.add_argument("--json", action="store_true")
    s.set_defaults(f=cmd_keys)
    s = sub.add_parser("export", help=T("보드를 .excalidraw 파일로", "Export boards as .excalidraw files"))
    s.add_argument("id")
    s.add_argument("--out", default=None)
    s.set_defaults(f=cmd_export)
    s = sub.add_parser("delete", help=T("닫힌 사이트의 그림까지 지우기", "Delete a closed site, drawings included"))
    s.add_argument("id")
    s.add_argument("--yes", action="store_true")
    s.set_defaults(f=cmd_delete)
    s = sub.add_parser("lang", help=T("화면 · 안내 글 언어 보기 · 바꾸기 (ko | en | auto)", "Show or set the language of messages (ko | en | auto)"))
    s.add_argument("value", nargs="?", choices=["ko", "en", "auto"], help=T("ko · en 은 저장, auto 는 저장한 값을 지운다. 없으면 지금 언어와 출처를 보여 준다", "ko / en saves the choice, auto clears it. Without it, shows the current language and where it comes from"))
    s.set_defaults(f=cmd_lang)
    s = sub.add_parser("_serve")
    s.add_argument("id")
    s.set_defaults(f=cmd_serve)
    load_extensions(sub)
    a = ap.parse_args()
    if a.cmd == "stop" and not a.id and not a.all:
        ap.error(T("stop <id> 또는 --all", "stop <id> or --all"))
    a.f(a)


if __name__ == "__main__":
    main()
